# TELEFAM PRODUCTION KTOR BACKEND ENVIRONMENT (api.telefam.company)
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
PUBLIC_DOMAIN=https://api.telefam.company
CDN_DOMAIN=https://cdn.telefam.company

# PostgreSQL 16 Connection Pool (HikariCP + SSL Strict)
POSTGRES_JDBC_URL=jdbc:postgresql://db.telefam.company:5432/telefam_production?sslmode=verify-full
POSTGRES_USER=telefam_core_rw
POSTGRES_PASSWORD=CHANGE_IN_PRODUCTION_VAULT
POSTGRES_MAX_POOL_SIZE=24

# Cryptographic Keys & Token Signing
JWT_ISSUER=https://api.telefam.company
JWT_AUDIENCE=com.telefam.company.app
JWT_SECRET_KEY=CHANGE_IN_PRODUCTION_HSM_256BIT_SECRET
SESSION_AES_GCM_MASTER_KEY=CHANGE_IN_PRODUCTION_AES256_GCM_KEY
SERVER_FINGERPRINT_PEPPER=CHANGE_IN_PRODUCTION_PEPPER_SECRET

# Sandbox & Secure Media Storage
SANDBOX_WORK_DIR=/var/telefam/sandbox/quarantine
SECURE_STORAGE_DIR=/var/telefam/storage/verified_avatars
MAX_UPLOAD_BYTES=5242880

# Rate Limiting & Anti-Brute-Force Policy
LOGIN_MAX_ATTEMPTS=3
LOGIN_COOLDOWN_MINUTES=15
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_MINUTES=30
OTP_RESEND_SECONDS=60
OTP_TTL_MINUTES=10
API_BURST_LIMIT_PER_MINUTE=30

# Email OTP Dispatch (Resend API) & Google OAuth 2.0
RESEND_API_KEY=CHANGE_IN_PRODUCTION_RESEND_API_KEY
RESEND_FROM_EMAIL=Telefam <no-reply@telefam.company>
GOOGLE_CLIENT_ID=CHANGE_IN_PRODUCTION_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_IN_PRODUCTION_GOOGLE_CLIENT_SECRET

# Klipy Stickers, GIFs & Clips Provider (Server-Side Secret Only)
KLIPY_API_KEY=CHANGE_IN_PRODUCTION_KLIPY_API_KEY
KLIPY_BASE_URL=https://api.klipy.co/api/v1


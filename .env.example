# TELEFAM PRODUCTION ENVIRONMENT CONFIGURATION (telefam.company)
# Configure actual production secrets via the Secrets panel in AI Studio.
TELEFAM_API_BASE_URL=https://api.telefam.company
TELEFAM_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
TELEFAM_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
RESEND_API_KEY=YOUR_RESEND_API_KEY
TELEFAM_HMAC_CLIENT_KEY=telefam_hmac_v1_signing_key
TELEFAM_STORAGE_CDN_URL=https://cdn.telefam.company
